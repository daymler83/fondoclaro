<!-- Div donde va el título y la introducción -->
   <div id="titulo">
      <div>
         <h1><strong>U. F. 2012</strong></h1><br />
         En esta página usted puede encontrar los valores de la Unidad de Fomento (UF) del año 2012. Las columnas de estas tablas corresponden a los meses del año, mientras que las filas corresponden a los días de cada mes, de esta forma se cubren los valores de la UF para todos los días del año.
      </div>  
   </div>
<!-- Fin Div donde va el título y la introducción -->	

