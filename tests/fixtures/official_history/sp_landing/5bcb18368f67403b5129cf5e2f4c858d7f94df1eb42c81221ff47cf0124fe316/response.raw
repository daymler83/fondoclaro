<script language='JavaScript'>
function generaXLS()
{
   aaaaini = document.genxls.aaaaini[document.genxls.aaaaini.selectedIndex].value;
   aaaafin = document.genxls.aaaafin[document.genxls.aaaafin.selectedIndex].value;

   if ( aaaaini > aaaafin ) {
      alert( "Año de inicio debe ser anterior al de término" );
      return;
   }

   getParams="aaaaini="+aaaaini+"&aaaafin="+aaaafin+"&tf=B&fecconf=20261031"
   document.location.href="vcfAFPxls.php?"+getParams;
}
function busca_dias(objeto)
{
  ann = document.vcf.aaaa.value;
  mm = objeto.value;
  dd = diasmes(mm,ann);
 // alert(dd);
  document.vcf.dd.length = dd;
  j = 1;
  for (i=0;i<dd;i++)
  {
    if(j<10)
       num = '0'+j;
    else  
       num = j;
     document.vcf.dd.options[i].text = num;
    j++;
  }
  document.vcf.dd.selectedIndex = 0;
}

function diasmes(mm, ann) 
{
  return new Date(ann || new Date().getFullYear(), mm, 0).getDate();
}
</script>


